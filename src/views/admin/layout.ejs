    <a href="/admin/problems" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg text-sm font-medium transition-all <%= typeof activeTab !== 'undefined' && activeTab === 'problems' ? 'bg-indigo-50 text-indigo-700' : 'text-gray-500 hover:text-gray-700 hover:bg-gray-50' %>">
