<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<%
  const statusStyle = {
    UPCOMING: 'text-blue-600 bg-blue-50',
    RUNNING: 'text-emerald-600 bg-emerald-50',
    ENDED: 'text-gray-500 bg-gray-100',
  };
  const diffColor = { EASY: 'text-emerald-600', MEDIUM: 'text-amber-600', HARD: 'text-red-600' };
  function formatDate(d) {
    return new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' });
  }
%>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6" x-data="{ tab: 'problems', registering: false }">
  <a href="/contests" class="inline-flex items-center gap-1 text-sm text-gray-500 hover:text-gray-700 mb-4">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
    Back to Contests
  </a>

  <div class="bg-white rounded-2xl border border-gray-100 overflow-hidden mb-6">
    <div class="px-6 py-5 border-b border-gray-100">
      <div class="flex items-start justify-between flex-wrap gap-4">
        <div>
          <div class="flex items-center gap-3 mb-2">
            <h1 class="text-xl font-bold text-gray-900"><%= contest.title %></h1>
            <span class="text-xs font-semibold px-2.5 py-1 rounded-lg <%= statusStyle[contest.status] || '' %>"><%= contest.status %></span>
          </div>
          <% if (contest.description) { %>
            <p class="text-sm text-gray-500"><%= contest.description %></p>
          <% } %>
          <div class="flex items-center gap-4 text-xs text-gray-400 mt-3">
            <span class="flex items-center gap-1">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              <%= formatDate(contest.start_time) %>
            </span>
            <span class="flex items-center gap-1">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              <%= formatDate(contest.end_time) %>
            </span>
          </div>
        </div>
        <% if (contest.status !== 'ENDED' && !isRegistered) { %>
          <button @click="registerContest()" :disabled="registering" class="px-5 py-2 rounded-xl bg-indigo-600 text-white text-sm font-medium hover:bg-indigo-700 transition-all disabled:opacity-50">
            <span x-text="registering ? 'Registering...' : 'Register'"></span>
          </button>
        <% } %>
        <% if (isRegistered) { %>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-emerald-50 text-emerald-600 text-sm font-medium">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            Registered
          </span>
        <% } %>
      </div>
    </div>

    <div class="px-6">
      <div class="flex gap-4 border-b border-gray-100">
        <button @click="tab = 'problems'" :class="tab === 'problems' ? 'text-indigo-600 border-b-2 border-indigo-600' : 'text-gray-400 hover:text-gray-600'" class="py-3 text-sm font-medium transition-colors">Problems</button>
        <button @click="tab = 'standings'" :class="tab === 'standings' ? 'text-indigo-600 border-b-2 border-indigo-600' : 'text-gray-400 hover:text-gray-600'" class="py-3 text-sm font-medium transition-colors">Standings</button>
      </div>
    </div>

    <div class="p-6">
      <div x-show="tab === 'problems'">
        <% if (!contest.problems || contest.problems.length === 0) { %>
          <p class="text-sm text-gray-400 text-center py-8">No problems yet</p>
        <% } else { %>
          <div class="space-y-2">
            <% contest.problems.forEach(function(p, i) { %>
              <a href="/problems/<%= p.id %>" class="flex items-center justify-between p-4 rounded-xl bg-gray-50/50 border border-gray-100 hover:border-gray-200 transition-all">
                <div class="flex items-center gap-3">
                  <span class="text-sm font-mono text-gray-400 w-6"><%= String.fromCharCode(65 + i) %></span>
                  <span class="text-sm font-medium text-gray-900"><%= p.title %></span>
                </div>
                <span class="text-xs font-semibold <%= diffColor[p.difficulty] || '' %>"><%= p.difficulty %></span>
              </a>
            <% }); %>
          </div>
        <% } %>
      </div>

      <div x-show="tab === 'standings'" x-cloak>
        <% if (standings.length === 0) { %>
          <p class="text-sm text-gray-400 text-center py-8">No standings yet</p>
        <% } else { %>
          <div class="overflow-x-auto">
            <table class="w-full">
              <thead>
                <tr class="border-b border-gray-100">
                  <th class="text-left px-4 py-2.5 text-xs font-semibold text-gray-500 uppercase">#</th>
                  <th class="text-left px-4 py-2.5 text-xs font-semibold text-gray-500 uppercase">User</th>
                  <th class="text-left px-4 py-2.5 text-xs font-semibold text-gray-500 uppercase">Solved</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-50">
                <% standings.forEach(function(s, i) { %>
                  <tr class="hover:bg-gray-50/50">
                    <td class="px-4 py-3 text-sm text-gray-400 font-mono"><%= i + 1 %></td>
                    <td class="px-4 py-3">
                      <a href="/users/<%= s.user.username %>" class="text-sm font-medium text-gray-900 hover:text-indigo-600"><%= s.user.username %></a>
                    </td>
                    <td class="px-4 py-3 text-sm text-gray-700"><%= s.solved_count %></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<script>
  async function registerContest() {
    <% if (!user) { %>
      toast.error('Please login first');
      return;
    <% } %>
    try {
      await api.post('/contests/<%= contest.id %>/register');
      toast.success('Registered successfully!');
      setTimeout(() => location.reload(), 1000);
    } catch (err) {
      toast.error(err.message || 'Registration failed');
    }
  }
</script>

<%- include('../partials/footer') %>
