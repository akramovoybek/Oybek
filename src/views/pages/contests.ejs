<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<%
  const statusStyle = {
    UPCOMING: 'text-blue-600 bg-blue-50',
    RUNNING: 'text-emerald-600 bg-emerald-50',
    ENDED: 'text-gray-500 bg-gray-100',
  };
  function formatDate(d) {
    return new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' });
  }
%>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-8">
    <h1 class="text-2xl font-bold text-gray-900">Contests</h1>
    <p class="text-gray-500 text-sm mt-1">Compete and test your skills</p>
  </div>

  <% if (contests.length === 0) { %>
    <div class="text-center py-20 bg-white rounded-2xl border border-gray-100">
      <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-300 mx-auto mb-3"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
      <p class="text-gray-400">No contests available</p>
    </div>
  <% } else { %>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
      <% contests.forEach(function(c) { %>
        <a href="/contests/<%= c.id %>" class="group bg-white rounded-2xl border border-gray-100 p-6 hover:border-gray-200 hover:shadow-lg hover:shadow-gray-100 transition-all">
          <div class="flex items-start justify-between mb-3">
            <h3 class="font-semibold text-gray-900 group-hover:text-indigo-600 transition-colors"><%= c.title %></h3>
            <span class="text-xs font-semibold px-2.5 py-1 rounded-lg <%= statusStyle[c.status] || '' %>"><%= c.status %></span>
          </div>
          <% if (c.description) { %>
            <p class="text-sm text-gray-500 mb-4 line-clamp-2"><%= c.description %></p>
          <% } %>
          <div class="flex items-center gap-4 text-xs text-gray-400">
            <span class="flex items-center gap-1">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              <%= formatDate(c.start_time) %>
            </span>
          </div>
        </a>
      <% }); %>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
