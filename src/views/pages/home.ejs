<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<!-- Hero -->
<section class="relative overflow-hidden bg-white">
  <div class="absolute inset-0 bg-gradient-to-br from-indigo-50 via-white to-purple-50"></div>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 lg:py-32">
    <div class="text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-50 text-indigo-700 text-sm font-medium mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
        Competitive Programming Platform
      </div>
      <h1 class="text-5xl lg:text-6xl font-bold text-gray-900 tracking-tight leading-tight">
        Sharpen Your
        <span class="text-indigo-600"> Coding Skills</span>
      </h1>
      <p class="mt-6 text-lg text-gray-500 leading-relaxed max-w-2xl mx-auto">
        Solve challenging problems, compete in contests, and track your progress.
        Join a community of developers pushing their limits.
      </p>
      <div class="mt-10 flex items-center justify-center gap-4">
        <a href="/problems" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-indigo-600 text-white font-medium hover:bg-indigo-700 transition-all shadow-lg shadow-indigo-200">
          Start Solving
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a href="/contests" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-white text-gray-700 font-medium hover:bg-gray-50 transition-all border border-gray-200">
          View Contests
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Features -->
<section class="py-20 bg-white border-t border-gray-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl font-bold text-gray-900">Everything you need to improve</h2>
      <p class="mt-3 text-gray-500">Practice, compete, and grow as a developer</p>
    </div>
    <div class="grid md:grid-cols-3 gap-8">
      <div class="group p-8 rounded-2xl bg-gray-50/50 border border-gray-100 hover:border-gray-200 hover:shadow-lg hover:shadow-gray-100 transition-all">
        <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-indigo-100 text-indigo-600 mb-5">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="22" y1="12" x2="18" y2="12"/><line x1="6" y1="12" x2="2" y2="12"/><line x1="12" y1="6" x2="12" y2="2"/><line x1="12" y1="22" x2="12" y2="18"/></svg>
        </div>
        <h3 class="text-lg font-semibold text-gray-900 mb-2">Practice Problems</h3>
        <p class="text-gray-500 text-sm leading-relaxed">Curated problems across multiple difficulty levels and topics. Write Python solutions and get instant feedback.</p>
      </div>
      <div class="group p-8 rounded-2xl bg-gray-50/50 border border-gray-100 hover:border-gray-200 hover:shadow-lg hover:shadow-gray-100 transition-all">
        <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-amber-100 text-amber-600 mb-5">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
        </div>
        <h3 class="text-lg font-semibold text-gray-900 mb-2">Live Contests</h3>
        <p class="text-gray-500 text-sm leading-relaxed">Compete in timed contests against other developers. Climb the leaderboard and earn your rating.</p>
      </div>
      <div class="group p-8 rounded-2xl bg-gray-50/50 border border-gray-100 hover:border-gray-200 hover:shadow-lg hover:shadow-gray-100 transition-all">
        <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-emerald-100 text-emerald-600 mb-5">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
        </div>
        <h3 class="text-lg font-semibold text-gray-900 mb-2">Track Progress</h3>
        <p class="text-gray-500 text-sm leading-relaxed">Monitor your submissions, see your acceptance rate, and watch your skills grow over time.</p>
      </div>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="py-20 bg-gradient-to-br from-indigo-600 to-indigo-700">
  <div class="max-w-4xl mx-auto px-4 text-center">
    <h2 class="text-3xl font-bold text-white mb-4">Ready to start coding?</h2>
    <p class="text-indigo-200 mb-8 text-lg">Join now and start solving problems today.</p>
    <a href="/register" class="inline-flex items-center gap-2 px-8 py-3.5 rounded-xl bg-white text-indigo-600 font-semibold hover:bg-indigo-50 transition-all">
      Create Free Account
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
    </a>
  </div>
</section>

<!-- Footer -->
<footer class="bg-white border-t border-gray-100 py-8">
  <div class="max-w-7xl mx-auto px-4 flex items-center justify-between">
    <div class="flex items-center gap-2 text-gray-400">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m18 16 4-4-4-4"/><path d="m6 8-4 4 4 4"/><path d="m14.5 4-5 16"/></svg>
      <span class="text-sm font-medium">CodeArena</span>
    </div>
    <p class="text-sm text-gray-400">Competitive Programming Platform</p>
  </div>
</footer>

<%- include('../partials/footer') %>
