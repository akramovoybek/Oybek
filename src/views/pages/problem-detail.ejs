<%- include('../partials/header') %>
<!-- CodeMirror CSS & JS -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/codemirror.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/theme/monokai.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/codemirror.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/python/python.min.js"></script>
<%- include('../partials/navbar') %>

<%
  const diffColor = { EASY: 'text-emerald-600', MEDIUM: 'text-amber-600', HARD: 'text-red-600' };
  const verdictStyle = {
    ACCEPTED: 'text-emerald-600 bg-emerald-50',
    WRONG_ANSWER: 'text-red-600 bg-red-50',
    RUNTIME_ERROR: 'text-orange-600 bg-orange-50',
    TIME_LIMIT_EXCEEDED: 'text-amber-600 bg-amber-50',
    MEMORY_LIMIT_EXCEEDED: 'text-purple-600 bg-purple-50',
    COMPILATION_ERROR: 'text-red-600 bg-red-50',
    PENDING: 'text-gray-600 bg-gray-50',
  };
  const verdictLabel = {
    ACCEPTED: 'Accepted', WRONG_ANSWER: 'Wrong Answer', RUNTIME_ERROR: 'Runtime Error',
    TIME_LIMIT_EXCEEDED: 'Time Limit', MEMORY_LIMIT_EXCEEDED: 'Memory Limit',
    COMPILATION_ERROR: 'Compilation Error', PENDING: 'Pending',
  };
%>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6" x-data="problemPage()">
  <a href="/problems" class="inline-flex items-center gap-1 text-sm text-gray-500 hover:text-gray-700 mb-4">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
    Back to Problems
  </a>

  <div class="grid lg:grid-cols-2 gap-6">
    <!-- Left: Problem description -->
    <div class="bg-white rounded-2xl border border-gray-100 overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-100">
        <div class="flex items-center justify-between mb-2">
          <h1 class="text-xl font-bold text-gray-900"><%= problem.title %></h1>
          <span class="text-xs font-semibold <%= diffColor[problem.difficulty] || '' %>"><%= problem.difficulty %></span>
        </div>
        <div class="flex items-center gap-4 text-xs text-gray-400">
          <span class="flex items-center gap-1">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <%= problem.time_limit %>s
          </span>
          <span class="flex items-center gap-1">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="12" x2="2" y2="12"/><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/></svg>
            <%= problem.memory_limit %>MB
          </span>
          <% if (problem.topic) { %>
            <span class="bg-gray-100 px-2 py-0.5 rounded text-gray-500"><%= problem.topic.name %></span>
          <% } %>
        </div>
      </div>

      <div class="px-6 py-4">
        <div class="flex gap-4 border-b border-gray-100 mb-4">
          <button @click="tab = 'description'" :class="tab === 'description' ? 'text-indigo-600 border-b-2 border-indigo-600' : 'text-gray-400 hover:text-gray-600'" class="pb-2.5 text-sm font-medium transition-colors">Description</button>
          <button @click="tab = 'submissions'" :class="tab === 'submissions' ? 'text-indigo-600 border-b-2 border-indigo-600' : 'text-gray-400 hover:text-gray-600'" class="pb-2.5 text-sm font-medium transition-colors">Submissions</button>
        </div>

        <div x-show="tab === 'description'">
          <div class="space-y-4 text-sm text-gray-700 leading-relaxed">
            <div>
              <h3 class="font-semibold text-gray-900 mb-1">Description</h3>
              <p class="whitespace-pre-wrap"><%= problem.description %></p>
            </div>
            <% if (problem.input_description) { %>
              <div>
                <h3 class="font-semibold text-gray-900 mb-1">Input</h3>
                <p class="whitespace-pre-wrap"><%= problem.input_description %></p>
              </div>
            <% } %>
            <% if (problem.output_description) { %>
              <div>
                <h3 class="font-semibold text-gray-900 mb-1">Output</h3>
                <p class="whitespace-pre-wrap"><%= problem.output_description %></p>
              </div>
            <% } %>
            <% if (problem.testcases && problem.testcases.length > 0) { %>
              <div>
                <h3 class="font-semibold text-gray-900 mb-2">Examples</h3>
                <% problem.testcases.forEach(function(tc, i) { %>
                  <div class="mb-3 rounded-xl overflow-hidden border border-gray-100">
                    <div class="grid grid-cols-2 divide-x divide-gray-100">
                      <div class="p-3">
                        <div class="text-xs font-semibold text-gray-400 mb-1">Input</div>
                        <pre class="text-xs font-mono text-gray-700 whitespace-pre-wrap"><%= tc.input %></pre>
                      </div>
                      <div class="p-3">
                        <div class="text-xs font-semibold text-gray-400 mb-1">Output</div>
                        <pre class="text-xs font-mono text-gray-700 whitespace-pre-wrap"><%= tc.expected_output %></pre>
                      </div>
                    </div>
                  </div>
                <% }); %>
              </div>
            <% } %>
          </div>
        </div>

        <div x-show="tab === 'submissions'" x-cloak>
          <div class="space-y-2" id="submissions-list">
            <% if (submissions.length === 0) { %>
              <p class="text-sm text-gray-400 py-8 text-center">No submissions yet</p>
            <% } else { %>
              <% submissions.forEach(function(s) { %>
                <div class="flex items-center justify-between p-3 rounded-xl bg-gray-50/50 border border-gray-100">
                  <div class="flex items-center gap-3">
                    <span class="text-xs font-semibold px-2.5 py-1 rounded-lg <%= verdictStyle[s.verdict] || 'text-gray-600 bg-gray-50' %>">
                      <%= verdictLabel[s.verdict] || s.verdict %>
                    </span>
                    <% if (s.passed_testcases !== undefined && s.passed_testcases !== null) { %>
                      <span class="text-xs text-gray-400"><%= s.passed_testcases %>/<%= s.total_testcases %> passed</span>
                    <% } %>
                  </div>
                  <span class="text-xs text-gray-400"><%= new Date(s.created_at || s.createdAt).toLocaleString() %></span>
                </div>
              <% }); %>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <!-- Right: Code editor -->
    <div class="flex flex-col gap-4">
      <div class="bg-white rounded-2xl border border-gray-100 overflow-hidden flex-1">
        <div class="px-4 py-3 border-b border-gray-100 flex items-center justify-between">
          <span class="text-sm font-medium text-gray-700">Python 3</span>
          <button @click="submitCode()" :disabled="submitting" class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-lg bg-emerald-600 text-white text-sm font-medium hover:bg-emerald-700 transition-all disabled:opacity-50">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg>
            <span x-text="submitting ? 'Running...' : 'Submit'"></span>
          </button>
        </div>
        <div id="code-editor"></div>
      </div>

      <!-- Result -->
      <template x-if="result">
        <div :class="result.verdict === 'ACCEPTED' ? 'bg-emerald-50/50 border-emerald-200' : 'bg-red-50/50 border-red-200'" class="rounded-2xl border p-5">
          <div class="flex items-center gap-2 mb-2">
            <template x-if="result.verdict === 'ACCEPTED'">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-600"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            </template>
            <template x-if="result.verdict !== 'ACCEPTED'">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-red-600"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
            </template>
            <span :class="result.verdict === 'ACCEPTED' ? 'text-emerald-700' : 'text-red-700'" class="font-semibold text-sm" x-text="result.verdictLabel"></span>
          </div>
          <div class="flex gap-4 text-xs text-gray-500">
            <template x-if="result.passed_testcases !== undefined">
              <span x-text="'Tests: ' + result.passed_testcases + '/' + result.total_testcases"></span>
            </template>
            <template x-if="result.execution_time">
              <span x-text="'Time: ' + result.execution_time + 'ms'"></span>
            </template>
            <template x-if="result.memory_used">
              <span x-text="'Memory: ' + result.memory_used + 'MB'"></span>
            </template>
          </div>
        </div>
      </template>
    </div>
  </div>
</div>

<script>
  // Initialize CodeMirror
  const editor = CodeMirror(document.getElementById('code-editor'), {
    value: '# Write your Python solution here\n\n',
    mode: 'python',
    theme: 'default',
    lineNumbers: true,
    indentUnit: 4,
    tabSize: 4,
    indentWithTabs: false,
    lineWrapping: true,
    viewportMargin: Infinity,
  });
  editor.setSize(null, '400px');

  const verdictLabels = {
    ACCEPTED: 'Accepted', WRONG_ANSWER: 'Wrong Answer', RUNTIME_ERROR: 'Runtime Error',
    TIME_LIMIT_EXCEEDED: 'Time Limit', MEMORY_LIMIT_EXCEEDED: 'Memory Limit',
    COMPILATION_ERROR: 'Compilation Error', PENDING: 'Pending',
  };

  function problemPage() {
    return {
      tab: 'description',
      submitting: false,
      result: null,
      async submitCode() {
        <% if (!user) { %>
          toast.error('Please login to submit');
          return;
        <% } %>
        this.submitting = true;
        this.result = null;
        try {
          const data = await api.post('/submissions', {
            problem_id: <%= problem.id %>,
            code: editor.getValue(),
            language: 'python',
          });
          const sub = data.submission;
          sub.verdictLabel = verdictLabels[sub.verdict] || sub.verdict;
          this.result = sub;
          if (sub.verdict === 'ACCEPTED') {
            toast.success('Accepted!');
          } else {
            toast.error(sub.verdictLabel);
          }
          // Reload to update submissions list
          setTimeout(() => location.reload(), 1500);
        } catch (err) {
          toast.error(err.message || 'Submission failed');
        } finally {
          this.submitting = false;
        }
      }
    };
  }
</script>

<%- include('../partials/footer') %>
