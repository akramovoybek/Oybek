<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<%
  const diffColor = { EASY: 'text-emerald-600', MEDIUM: 'text-amber-600', HARD: 'text-red-600' };
  const verdictStyle = {
    ACCEPTED: 'text-emerald-600 bg-emerald-50',
    WRONG_ANSWER: 'text-red-600 bg-red-50',
    RUNTIME_ERROR: 'text-orange-600 bg-orange-50',
    TIME_LIMIT_EXCEEDED: 'text-amber-600 bg-amber-50',
    PENDING: 'text-gray-600 bg-gray-50',
  };
  const verdictLabel = {
    ACCEPTED: 'Accepted', WRONG_ANSWER: 'Wrong Answer', RUNTIME_ERROR: 'Runtime Error',
    TIME_LIMIT_EXCEEDED: 'Time Limit', PENDING: 'Pending',
  };
%>

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <!-- Profile header -->
  <div class="bg-white rounded-2xl border border-gray-100 p-6 mb-6">
    <div class="flex items-center gap-4">
      <div class="w-16 h-16 rounded-2xl bg-indigo-100 flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-indigo-600"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      </div>
      <div>
        <h1 class="text-xl font-bold text-gray-900"><%= profile.username %></h1>
        <div class="flex items-center gap-4 mt-1">
          <span class="text-sm text-gray-500 flex items-center gap-1">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-amber-500"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
            Rating: <strong class="text-gray-700"><%= profile.rating || 0 %></strong>
          </span>
          <span class="text-sm text-gray-400 flex items-center gap-1">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            Joined <%= new Date(profile.created_at || profile.createdAt).toLocaleDateString('en-US', { month: 'short', year: 'numeric' }) %>
          </span>
        </div>
      </div>
    </div>
  </div>

  <!-- Stats -->
  <div class="grid grid-cols-3 gap-4 mb-6">
    <div class="bg-white rounded-2xl border border-gray-100 p-5 text-center">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-500 mx-auto mb-2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
      <div class="text-2xl font-bold text-gray-900"><%= solved_count %></div>
      <div class="text-xs text-gray-400 mt-1">Problems Solved</div>
    </div>
    <div class="bg-white rounded-2xl border border-gray-100 p-5 text-center">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-indigo-500 mx-auto mb-2"><path d="m18 16 4-4-4-4"/><path d="m6 8-4 4 4 4"/><path d="m14.5 4-5 16"/></svg>
      <div class="text-2xl font-bold text-gray-900"><%= verdict_stats.reduce((a, v) => a + parseInt(v.count), 0) %></div>
      <div class="text-xs text-gray-400 mt-1">Total Submissions</div>
    </div>
    <div class="bg-white rounded-2xl border border-gray-100 p-5 text-center">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-amber-500 mx-auto mb-2"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
      <div class="text-2xl font-bold text-gray-900"><%= profile.rating || 0 %></div>
      <div class="text-xs text-gray-400 mt-1">Rating</div>
    </div>
  </div>

  <!-- Solved problems -->
  <% if (solved_problems.length > 0) { %>
    <div class="bg-white rounded-2xl border border-gray-100 overflow-hidden mb-6">
      <div class="px-6 py-4 border-b border-gray-100">
        <h2 class="font-semibold text-gray-900">Solved Problems</h2>
      </div>
      <div class="divide-y divide-gray-50">
        <% solved_problems.forEach(function(p) { %>
          <a href="/problems/<%= p.problem_id %>" class="flex items-center justify-between px-6 py-3 hover:bg-gray-50/50 transition-colors">
            <span class="text-sm font-medium text-gray-900"><%= p.title %></span>
            <span class="text-xs font-semibold <%= diffColor[p.difficulty] || '' %>"><%= p.difficulty %></span>
          </a>
        <% }); %>
      </div>
    </div>
  <% } %>

  <!-- Recent submissions -->
  <% if (recent_submissions.length > 0) { %>
    <div class="bg-white rounded-2xl border border-gray-100 overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-100">
        <h2 class="font-semibold text-gray-900">Recent Submissions</h2>
      </div>
      <div class="divide-y divide-gray-50">
        <% recent_submissions.forEach(function(s) { %>
          <div class="flex items-center justify-between px-6 py-3">
            <div class="flex items-center gap-3">
              <span class="text-xs font-semibold px-2.5 py-1 rounded-lg <%= verdictStyle[s.verdict] || 'text-gray-600 bg-gray-50' %>">
                <%= verdictLabel[s.verdict] || s.verdict %>
              </span>
              <% if (s.problem) { %>
                <a href="/problems/<%= s.problem.id %>" class="text-sm text-gray-700 hover:text-indigo-600"><%= s.problem.title %></a>
              <% } %>
            </div>
            <span class="text-xs text-gray-400"><%= new Date(s.created_at || s.createdAt).toLocaleString() %></span>
          </div>
        <% }); %>
      </div>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
